# Required before the contact form can send. Until both are set, the form
# answers with a clear error and does not pretend to deliver.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional. Defaults to Resend's onboarding sender, which only delivers to
# the address on the Resend account until a domain is verified.
CONTACT_FROM_EMAIL=

# Optional. Absolute links in the RSS feed. On Vercel this is inferred.
NEXT_PUBLIC_SITE_URL=

# Editing. The password opens /edit. Saving on the live site also needs a
# GitHub token that can write this repo, as owner/name.
EDIT_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=

# New-post emails. Create a segment in Resend and put its id here.
# Audiences are the old name; use a segment.
RESEND_SEGMENT_ID=
